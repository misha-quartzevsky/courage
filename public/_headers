# Cloudflare Pages: заголовки кэширования.
# Хэшированные ассеты Vite неизменны — кэшируем навсегда.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Точки входа обновления — всегда перепроверять на сервере.
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
