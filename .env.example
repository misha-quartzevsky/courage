# Транспорт к Gemini идёт через Cloudflare Worker-прокси (worker/worker.ts).
# Сам ключ GEMINI_API_KEY хранится ТОЛЬКО как секрет Worker'а:
#   wrangler secret put GEMINI_API_KEY
#
# Скопируйте в .env и впишите адрес вашего задеплоенного Worker'а (без слэша в конце):
VITE_GEMINI_WORKER_URL=https://courage.mishaquartzevsky.workers.dev

# Supabase (URL + anon key — публичные, но в .env, а не в коде):
#   VITE_SUPABASE_URL=https://<project>.supabase.co
#   VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=